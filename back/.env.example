# espacioGYM Server Environment Variables Example
# Copy to server/.env (never commit real .env files)

PORT=3000
NODE_ENV=development
SQLITE_DB_PATH=./edge_gym.db

# Auth & OAuth
JWT_SECRET=replace-with-strong-random-32-byte-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# AI Providers (Coach IA)
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_LLAVE=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
MERCURY_API_KEY=replace_with_mercury_api_key
MAX_AI_QUOTA=15

# Email Providers
RESEND_API_KEY=replace_with_resend_api_key
BREVO_API_KEY=replace_with_brevo_api_key
EMAIL_FROM=espacioGYM <noreply@example.com>
EMAIL_USER=
EMAIL_PASS=
SMTP_SERVICE=gmail

# Optional Initial Admin Seed
SEED_ADMIN_EMAIL=admin@gymseminario.com
SEED_ADMIN_PASSWORD=
