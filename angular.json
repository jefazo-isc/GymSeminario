{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "libreria1": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/libreria1",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles/material.scss", "src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "7MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "libreria1:build:production"
            },
            "development": {
              "buildTarget": "libreria1:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "configurations": {
            "frontend": {
              "tsConfig": "tsconfig.frontend.spec.json",
              "include": [
                "src/app/app.component.spec.ts",
                "src/app/components/navbar/navbar.component.spec.ts",
                "src/app/components/footer/footer.component.spec.ts",
                "src/app/core/**/*.spec.ts",
                "src/app/shared/**/*.spec.ts",
                "src/app/testing/phase2/**/*.spec.ts"
              ]
            },
            "design": {
              "tsConfig": "tsconfig.design.spec.json",
              "include": [
                "src/app/app.component.spec.ts",
                "src/app/components/navbar/navbar.component.spec.ts",
                "src/app/components/footer/footer.component.spec.ts",
                "src/app/core/**/*.spec.ts",
                "src/app/shared/**/*.spec.ts"
              ]
            }
          },
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles/material.scss", "src/styles.css"],
            "scripts": []
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
