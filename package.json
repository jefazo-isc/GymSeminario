{
  "name": "libreria1",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "server": "node server/index.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:design": "node scripts/check-design.cjs",
    "test:design": "ng test --configuration design --watch=false --browsers=ChromeHeadless",
    "test:frontend": "ng test --configuration frontend --watch=false --browsers=ChromeHeadless",
    "check:architecture": "node scripts/check-architecture.cjs",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.spec.json",
    "build:mobile": "ng build --configuration production --base-href /",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:copy": "npx cap copy android",
    "cap:open:android": "npx cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.14",
    "@angular/cdk": "^19.2.15",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.15",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.0",
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@google/genai": "^2.24.0",
    "angularx-qrcode": "^19.0.0",
    "chart.js": "^4.5.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^11.9.1",
    "marked": "^18.1.3",
    "ng2-charts": "^8.0.0",
    "nodemailer": "^10.3.1",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.19.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.8",
    "@angular/cli": "^19.2.8",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/cli": "^7.6.10",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^2.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
